{
  "//_comment": "Copy this file to config.json and fill in your Jellyseerr + WAHA details.",
  "protocol": "http",
  "host": "localhost",
  "jellyseerr": {
    "port": 5055,
    "apiKey": "YOUR_JELLYSEERR_API_KEY",
    "defaultUserId": 2,
    "defaultServer": null
  },
  "waha": {
    "port": 8584,
    "apiKey": "YOUR_WAHA_API_KEY",
    "session": "default"
  },
  "webhook": {
    "port": 3003,
    "path": "/webhook"
  },
  "logging": {
    "level": "info",
    "timestamps": false
  }
}


